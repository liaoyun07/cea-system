{
  "applicationId": "fl-init",
  "version": "v1",
  "image": "registry.example/lab/cea-federated:s5-v1",
  "parameters": {
    "ALGORITHM": {
      "type": "STRING",
      "required": true,
      "defaultValue": "fedavg",
      "choices": [
        "fedavg",
        "fedprox"
      ]
    },
    "TRAINING_DATASET": {
      "type": "STRING",
      "required": true,
      "defaultValue": "mnist-train/v1",
      "choices": [
        "mnist-train/v1",
        "cifar10-train/v1",
        "cifar100-train/v1"
      ]
    },
    "TEST_DATASET": {
      "type": "STRING",
      "required": true,
      "defaultValue": "mnist-test/v1",
      "choices": [
        "mnist-test/v1",
        "cifar10-test/v1",
        "cifar100-test/v1"
      ]
    },
    "MODEL": {
      "type": "STRING",
      "required": true,
      "defaultValue": "mlp",
      "choices": [
        "mlp",
        "cnn"
      ]
    },
    "SEED": {
      "type": "INTEGER",
      "required": true,
      "defaultValue": 13
    }
  }
}
