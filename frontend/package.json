    "format:check": "prettier --check src tests *.js *.html *.json"
  },
  "dependencies": {
    "vue": "3.5.42",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  }
}
