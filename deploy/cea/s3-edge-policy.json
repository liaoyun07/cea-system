{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::cea-artifacts-edge-a", "arn:aws:s3:::cea-artifacts-edge-b", "arn:aws:s3:::cea-artifacts-edge-c"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::cea-artifacts-edge-a/lab/*", "arn:aws:s3:::cea-artifacts-edge-b/lab/*", "arn:aws:s3:::cea-artifacts-edge-c/lab/*"]
    }
  ]
}
