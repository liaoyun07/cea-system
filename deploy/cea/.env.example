# Copy through initialize.ps1; generated .env contains random local credentials and is ignored by Git.
COMPOSE_PROJECT_NAME=cea
CEA_HTTP_PORT=18080
CEA_API_PORT=18085
CEA_MYSQL_PORT=18306
CEA_S3_PORT=18900
CEA_S3_CONSOLE_PORT=18901
BACKEND_USER=developer
BACKEND_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
BACKEND_DB_USER=cea
BACKEND_DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MINIO_ROOT_USER=cea-root
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
CEA_S3_ACCESS_KEY=cea-backend
CEA_S3_SECRET_KEY=REPLACE_WITH_RANDOM_PASSWORD
REGISTRY_USER=cea-registry
REGISTRY_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
